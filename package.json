{
  "name": "gpu-particle-lab-week1-ui-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && npm run typecheck:tests && vite build",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --grep-invert @evidence",
    "test:a11y": "playwright test --grep @a11y",
    "evidence:screenshots": "playwright test --grep @evidence",
    "verify": "npm run typecheck && npm run typecheck:tests && npm test && npm run test:e2e && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "@types/three": "0.186.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "three": "0.186.1"
  }
}
